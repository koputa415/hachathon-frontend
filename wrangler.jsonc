{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hachathon-frontend",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/images",
      "/images/*"
    ]
  },
  "previews": {},
  "main": "cloudflare-worker.js",
  "keep_vars": true
}
